import aspersor.*
import wollok.game.*
import personaje.*
import cultivos.*
import mercado.*



program farmville {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("ground.png")

	//  VISUALES
	game.addVisualCharacter(personaje)
	// game.addVisual(new Maiz()) 
	// game.addVisual(new Trigo())
	// game.addVisual(new Tomate())
	// game.addVisual(new Aspersor())
	game.addVisual(new Mercado(position=game.at(0,9)))
	game.addVisual(new Mercado(position=game.at(9,9) ))
	game.addVisual(new Mercado(position=game.at(5,0)))

	// plantar
	keyboard.m().onPressDo({personaje.sembrar(new Maiz())})
	keyboard.t().onPressDo({personaje.sembrar(new Trigo())})
	keyboard.o().onPressDo({personaje.sembrar(new Tomate())})
	//regar
	keyboard.r().onPressDo({personaje.regar()})
	//cosechar
	keyboard.c().onPressDo({personaje.cosechar()})

	//venta y mercado
	keyboard.v().onPressDo({personaje.vender()})
	keyboard.space().onPressDo({personaje.info()})
	//aspersores
	keyboard.a().onPressDo({personaje.colocarAspersor(new Aspersor())})

	

 	//  COMIENZA
	game.start()
}
